<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatform>windows10.0.17763.0</SupportedOSPlatform>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>WFAC010</NoWarn>

    <!-- Assembly metadata - shown in file properties & installer -->
    <Version>2.1.1</Version>
    <AssemblyVersion>2.1.1.0</AssemblyVersion>
    <FileVersion>2.1.1.0</FileVersion>
    <AssemblyName>SimpleScreen</AssemblyName>
    <Product>SimpleScreen</Product>
    <AssemblyTitle>SimpleScreen</AssemblyTitle>
    <Authors>xunhualu</Authors>
    <Company>xunhualu</Company>
    <Description>Sound follows your windows. Per-app audio routing for multi-monitor Windows — each app plays through the speaker paired with the monitor it's on. A customized fork of ScreenSound.</Description>
    <Copyright>Copyright (c) 2026 Omar Omran, xunhualu</Copyright>
    <RepositoryUrl>https://github.com/xunhualu/SimpleScreen</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WindowsDisplayAPI" Version="1.3.0.13" />
    <PackageReference Include="WPF-UI" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      app.ico is already embedded as the Win32 executable icon via
      <ApplicationIcon> above. We additionally pack it as a WPF resource so the
      tray-icon setup (see MainWindow.xaml.cs > SetupTrayIcon) can load it via a
      pack:// URI and ask for a specific DPI-scaled frame rather than whatever
      ExtractAssociatedIcon happens to return. The duplicated ~8 KB is worth a
      crisp tray glyph.

      app-icon.png is a 256x256 rasterisation of design/app-icon.svg used by the
      About page. WPF's BitmapImage picks the first frame of a multi-image ICO
      rather than the largest, so pointing Image.Source at app.ico produces a
      blurry 16x16 glyph scaled up. A single PNG sidesteps that entirely.
      Regenerate via the IconBuilder tool at design/tools/IconBuilder, see
      its Program.cs header for the exact dotnet run invocation.
    -->
    <Resource Include="app.ico" />
    <Resource Include="Assets\app-icon.png" />
    <!--
      Official Ko-fi "Buy me a coffee" branded button from
      https://storage.ko-fi.com/cdn/kofi2.png. Ko-fi explicitly provides this
      asset for embedding by supporters, so bundling it in the app is within
      their brand guidelines. Used as the Donate page CTA — the branded
      button reads more as a real call-to-action than a generic text link.
    -->
    <Resource Include="Assets\kofi-button.png" />
  </ItemGroup>

</Project>
