<wpfui:UiWindow x:Class="ScreenSound.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ScreenSound.ViewModels"
        xmlns:attached="clr-namespace:ScreenSound.Attached"
        xmlns:controls="clr-namespace:ScreenSound.Controls"
        Title="SimpleScreen"
        Height="720" Width="900"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="/Assets/app-icon.png">

    <wpfui:UiWindow.Resources>
        <!-- Sidebar nav button style (accent bar only, no box) -->
        <Style x:Key="SidebarNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" Padding="0,14">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="16"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="0,2,2,0" Background="Transparent"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable slider value: looks like plain text, reveals a subtle
             field only on hover/focus so it is clear the number can be typed. -->
        <Style TargetType="controls:EditableValueBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bordered variant of the editable value box. Matches the plain
             peak-nits TextBox: a real field with its unit label OUTSIDE the
             box, instead of the borderless text look used on the sliders. -->
        <Style x:Key="BorderedValueBox" TargetType="controls:EditableValueBox"
               BasedOn="{StaticResource {x:Type controls:EditableValueBox}}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </wpfui:UiWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar: no background — raw Mica shows through (darkest surface) -->

        <!-- Content panel: translucent raised sheet over Mica, rounded top-left corner -->
        <Border Grid.Column="1" Grid.Row="1" CornerRadius="8,0,0,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>

        <!-- ── TITLE BAR ── -->
        <wpfui:TitleBar Grid.ColumnSpan="2" Grid.Row="0"
                        Title="SimpleScreen"
                        ShowMinimize="True" ShowMaximize="True" ShowClose="True"/>

        <!-- ── SIDEBAR ── -->
        <DockPanel Grid.Column="0" Grid.Row="1" LastChildFill="False">
            <RadioButton DockPanel.Dock="Top" GroupName="Nav" IsChecked="True"
                         Checked="NavButton_Checked" Tag="0"
                         Style="{StaticResource SidebarNavButton}">
                <StackPanel HorizontalAlignment="Center">
                    <wpfui:SymbolIcon Symbol="Home24" FontSize="22" HorizontalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock Text="{DynamicResource Nav_Home}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton DockPanel.Dock="Top" GroupName="Nav"
                         Checked="NavButton_Checked" Tag="5"
                         Style="{StaticResource SidebarNavButton}">
                <StackPanel HorizontalAlignment="Center">
                    <wpfui:SymbolIcon Symbol="Desktop24" FontSize="22" HorizontalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock Text="{DynamicResource Nav_ScreenDetails}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton DockPanel.Dock="Top" GroupName="Nav"
                         Checked="NavButton_Checked" Tag="1"
                         Style="{StaticResource SidebarNavButton}">
                <StackPanel HorizontalAlignment="Center">
                    <wpfui:SymbolIcon Symbol="Pin24" FontSize="22" HorizontalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock Text="{DynamicResource Nav_Pinned}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
            </RadioButton>

            <!--
                 Bottom-docked children stack upward from the bottom in XAML order:
                 About docks first → very bottom; Hotkeys next → above About;
                 Settings last → above Hotkeys. Visual top-to-bottom in the
                 sidebar's bottom cluster is Settings, Hotkeys, About.
            -->
            <RadioButton DockPanel.Dock="Bottom" GroupName="Nav"
                         Checked="NavButton_Checked" Tag="3"
                         Style="{StaticResource SidebarNavButton}">
                <StackPanel HorizontalAlignment="Center">
                    <wpfui:SymbolIcon Symbol="Info24" FontSize="22" HorizontalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock Text="{DynamicResource Nav_About}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton DockPanel.Dock="Bottom" GroupName="Nav"
                         Checked="NavButton_Checked" Tag="4"
                         Style="{StaticResource SidebarNavButton}">
                <StackPanel HorizontalAlignment="Center">
                    <wpfui:SymbolIcon Symbol="Keyboard24" FontSize="22" HorizontalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock Text="{DynamicResource Nav_Hotkeys}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton DockPanel.Dock="Bottom" GroupName="Nav"
                         Checked="NavButton_Checked" Tag="2"
                         Style="{StaticResource SidebarNavButton}">
                <StackPanel HorizontalAlignment="Center">
                    <wpfui:SymbolIcon Symbol="Settings24" FontSize="22" HorizontalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock Text="{DynamicResource Nav_Settings}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
            </RadioButton>
        </DockPanel>

        <!-- ── CONTENT AREA ── -->
        <Grid Grid.Column="1" Grid.Row="1" ClipToBounds="True">

            <!-- ═══ HOME PAGE ═══ -->
            <Border x:Name="HomePage" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <!-- Whole page scrolls (including the routing/brightness/mapping sections above),
                     otherwise a 3-monitor setup with the absolute-brightness panel expanded
                     overflows the window height and the bottom cards are unreachable. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <!-- Top section: Audio Routing + Brightness + Monitor Mappings + Sessions header -->
                    <StackPanel Grid.Row="0" Margin="0">
                        <wpfui:CardControl Margin="0,0,0,20">
                            <wpfui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="Speaker224" FontSize="22"
                                                      Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Home_AudioRouting_Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Home_AudioRouting_Desc}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </wpfui:CardControl.Header>
                            <wpfui:ToggleSwitch IsChecked="{Binding IsRoutingEnabled}"/>
                        </wpfui:CardControl>

                        <!-- Window size sync card. Same white Card shell as brightness sync:
                             icon | (title + desc + collapsible size editor) | toggle. The screen
                             diagonal inputs live INSIDE this card so they read as part of it,
                             not as a stray block floating between cards. -->
                        <wpfui:Card Margin="0,0,0,20" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <wpfui:SymbolIcon Grid.Column="0" Symbol="ScaleFit24" FontSize="22"
                                                  Margin="0,0,14,0" VerticalAlignment="Top"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Home_WindowScale_Title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Home_WindowScale_Desc}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>

                                    <!-- Collapsed chevron: one input per physical screen. Values feed
                                         real PPI so a panel's faked EDID size no longer matters. -->
                                    <Button Command="{Binding ToggleScreenSizeEditorCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="0,6,0,2"
                                            HorizontalAlignment="Left" Cursor="Hand"
                                            ToolTip="{DynamicResource SS_SizeHint}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsScreenSizeEditorExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#xE70E;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{DynamicResource SS_SizeHint}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Margin="0,4,0,0"
                                                Visibility="{Binding IsScreenSizeEditorExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding ScreenSizeEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ResolutionText}" FontSize="10"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>
                                                        <controls:EditableValueBox Grid.Column="1" Style="{StaticResource BorderedValueBox}"
                                                                   Value="{Binding Inches, Mode=TwoWay}"
                                                                   Minimum="10" Maximum="100" Decimals="1" Suffix=""
                                                                   Width="64" Height="26" FontSize="11"/>
                                                        <TextBlock Grid.Column="2" Text="{DynamicResource SS_InchUnit}" FontSize="11"
                                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <wpfui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsWindowScaleSyncEnabled}"
                                                    VerticalAlignment="Top"/>
                            </Grid>
                        </wpfui:Card>

                        <!-- Brightness Sync card -->
                        <wpfui:Card Margin="0,0,0,20" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <wpfui:SymbolIcon Grid.Column="0" Symbol="WeatherSunny24" FontSize="22"
                                                  Margin="0,0,14,0" VerticalAlignment="Top"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Home_Brightness_Title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Home_Brightness_Desc}"
                                               FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsBrightnessSyncEnabled, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <wpfui:SymbolIcon Grid.Column="0" Symbol="WeatherSunny24" FontSize="16"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                    Value="{Binding BrightnessValue, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                                    ToolTip="{DynamicResource Home_Brightness_SliderTip}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SliderValueText}"
                                                       FontSize="12" MinWidth="52" TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding BrightnessStatus}" FontSize="11" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="{DynamicResource Home_Brightness_Absolute}"
                                                      IsChecked="{Binding AbsoluteBrightnessSync}"
                                                      FontSize="12" VerticalAlignment="Center"/>
                                            <!-- Chevron toggle: details (peak-nits inputs) stay hidden
                                                 until the user explicitly opens them. Sits right
                                                 after the checkbox text. Raw Segoe glyph because an
                                                 overriding Style on wpfui:SymbolIcon would strip its
                                                 theme style (font/foreground) and render nothing. -->
                                            <Button Grid.Column="1" Command="{Binding ToggleAbsoluteDetailsCommand}"
                                                    Background="Transparent" BorderThickness="0" Padding="8,2"
                                                    VerticalAlignment="Center" Cursor="Hand" Margin="4,0,0,0"
                                                    ToolTip="{DynamicResource Home_Brightness_DetailsTip}">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" Text="&#xE70D;">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AbsoluteDetailsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE70E;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>

                                        <StackPanel Margin="0,4,0,0"
                                                    Visibility="{Binding AbsoluteDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{DynamicResource Home_Brightness_AbsoluteDesc}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                            <ItemsControl ItemsSource="{Binding BrightnessPeaks}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                       FontSize="11" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBox Grid.Column="1" Width="64" Height="26"
                                                                     FontSize="11" Padding="6,2"
                                                                     VerticalContentAlignment="Center"
                                                                     Text="{Binding PeakNits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="{DynamicResource Home_Brightness_PeakNits}"/>
                                                            <TextBlock Grid.Column="2" FontSize="11" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Text="{DynamicResource Brightness_NitsUnit}"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <wpfui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsBrightnessSyncEnabled}"
                                                    VerticalAlignment="Top"
                                                    ToolTip="{DynamicResource Home_Brightness_ToggleTip}"/>
                            </Grid>
                        </wpfui:Card>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Home_MonitorMappings}" FontSize="20" FontWeight="Medium" VerticalAlignment="Center"/>
                            <wpfui:Button Grid.Column="1" Icon="ArrowClockwise24" Appearance="Transparent"
                                          Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Home_Refresh_Tip}"
                                          Width="32" Height="32"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Monitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <wpfui:Card Margin="0,0,0,8" Padding="16"
                                                Visibility="{Binding IsCardVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Monitor icon -->
                                            <wpfui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="24"
                                                              Margin="0,0,14,0" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                            <!-- Monitor info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                                    <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            Visibility="{Binding IsDualLink, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{DynamicResource LD_DualLink_Badge}" FontSize="10.5" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Monitor.DeviceName}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Device selector + volume -->
                                            <StackPanel Grid.Column="2" MinWidth="280">
                                                <ComboBox ItemsSource="{Binding AvailableDevices}"
                                                          SelectedItem="{Binding SelectedAudioDevice}"
                                                          DisplayMemberPath="FriendlyName"/>

                                                <!-- Volume slider — only visible when a device is assigned -->
                                                <Grid Margin="0,10,0,0"
                                                      Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <wpfui:SymbolIcon Grid.Column="0" Symbol="Speaker224" FontSize="16"
                                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                            Value="{Binding Volume, Mode=TwoWay}"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Volume, StringFormat={}{0}%}"
                                                               FontSize="12" MinWidth="36" TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </wpfui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{DynamicResource Home_ActiveSessions}" FontSize="20" FontWeight="Medium" Margin="0,20,0,16"/>
                    </StackPanel>

                    <!-- Sessions card - grows with its content; the outer page-level ScrollViewer
                         scrolls everything, so no inner ScrollViewer here (avoids nested
                         scroll-wheel conflicts). -->
                    <Border Grid.Row="1" MinHeight="80"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <!-- TabNavigation=Once: one Tab lands on the first focusable row, then
                                 arrow keys navigate between rows — standard list-like keyboarding
                                 without needing a ListBox wrapper and its selection visuals. -->
                            <ItemsControl ItemsSource="{Binding ActiveSessions}"
                                          KeyboardNavigation.TabNavigation="Once"
                                          KeyboardNavigation.DirectionalNavigation="Contained">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Tag carries the row's session VM into the ContextMenu, which lives
                                                 outside the visual tree and can't reach DataContext directly. The
                                                 ContextMenuOpening handler reads it back via PlacementTarget.Tag.
                                                 Focusable + IsTabStop + PreviewKeyDown make pinning reachable from
                                                 the keyboard (Apps or Shift+F10 opens the same menu as right-click);
                                                 AutomationProperties.Name gives screen readers a meaningful label. -->
                                            <Border Padding="20,10"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Tag="{Binding}"
                                                    Focusable="True"
                                                    KeyboardNavigation.IsTabStop="True"
                                                    AutomationProperties.Name="{Binding ProcessName, StringFormat='Audio session {0}. Press Menu key or Shift+F10 to pin.'}"
                                                    ContextMenuOpening="SessionRow_ContextMenuOpening"
                                                    PreviewKeyDown="SessionRow_PreviewKeyDown">
                                                <!-- Background is driven by the style rather than a local value so
                                                     the IsKeyboardFocused trigger can take effect (local values
                                                     beat style triggers in WPF's property-precedence order). -->
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem x:Name="PinToDeviceMenu" Header="{DynamicResource Menu_PinToDevice}"/>
                                                        <Separator x:Name="PinSeparator"/>
                                                        <MenuItem x:Name="RemovePinMenu" Header="{DynamicResource Menu_RemovePin}"
                                                                  Click="RemovePin_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Image Source="{Binding Icon}" Width="20" Height="20"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="Medium"/>
                                                            <TextBlock Text="{Binding ProcessId, StringFormat='PID {0}'}" FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding MonitorName}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="13" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <wpfui:SymbolIcon Symbol="Pin24" FontSize="14"
                                                                          Margin="0,0,6,0" VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                          ToolTip="{DynamicResource Home_PinnedBadgeTip}"
                                                                          Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding AudioDeviceName}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ActiveSessions.Count, Converter={StaticResource ZeroToVis}}"
                                        IsHitTestVisible="False">
                                <wpfui:SymbolIcon Symbol="Speaker224" FontSize="32" Opacity="0.3"
                                                  HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Home_EmptySessions_Title}" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Home_EmptySessions_Desc}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ═══ SCREEN DETAILS PAGE ═══ -->
            <Border x:Name="MonitorDetailsPage" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SD_Title}" FontSize="20" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource SD_BrightnessNote}" FontSize="11" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                        <!-- Color sync: one tint for the whole desk -->
                        <wpfui:CardControl Margin="0,0,0,16">
                            <wpfui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="Color24" FontSize="22"
                                                      Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource SD_ColorSync_Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource SD_ColorSync_Desc}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </wpfui:CardControl.Header>
                            <wpfui:ToggleSwitch IsChecked="{Binding IsColorSyncEnabled}"/>
                        </wpfui:CardControl>

                        <ItemsControl ItemsSource="{Binding MonitorDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <wpfui:Card Margin="0,0,0,20" Padding="16"
                                                Visibility="{Binding IsCardVisible, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <!-- ── Header: numbered badge + name + tag + rename ── -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding MonitorNumber}" FontSize="15" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                        <!-- User label chip ("工作屏" / "便携屏") -->
                                                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                                Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                        </Border>
                                                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                Visibility="{Binding IsDualLink, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{DynamicResource LD_DualLink_Badge}" FontSize="10.5" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Monitor.DeviceName}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding DualLinkText}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"
                                                               Visibility="{Binding IsDualLink, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <!-- Rename / tag editor toggle -->
                                                <wpfui:Button Grid.Column="2" Icon="Edit24" Appearance="Transparent"
                                                              Width="32" Height="32" VerticalAlignment="Top"
                                                              Command="{Binding BeginEditIdentityCommand}"
                                                              AutomationProperties.Name="{DynamicResource Mon_RenameTip}"
                                                              ToolTip="{DynamicResource Mon_RenameTip}"/>
                                            </Grid>

                                            <!-- ── Inline identity editor ── -->
                                            <Grid Margin="44,0,0,12"
                                                  Visibility="{Binding IsEditingIdentity, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="{DynamicResource Mon_NameLabel}" FontSize="11" Margin="0,0,0,4"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBox Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{DynamicResource Mon_NamePlaceholder}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="{DynamicResource Mon_TagLabel}" FontSize="11" Margin="0,0,0,4"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBox Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                                             Text="{Binding EditTag, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{DynamicResource Mon_TagPlaceholder}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <wpfui:Button Content="{DynamicResource Mon_Save}" Appearance="Primary"
                                                                  Height="32" Command="{Binding SaveIdentityEditCommand}"/>
                                                    <wpfui:Button Content="{DynamicResource Mon_Cancel}" Height="32" Margin="8,0,0,0"
                                                                  Command="{Binding CancelIdentityEditCommand}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- ── Facts: one compact digest line + panel model ── -->
                                            <TextBlock Text="{Binding SummaryText}" FontSize="12" Margin="44,0,0,2"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="44,0,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PanelName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{DynamicResource SD_PanelName}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text=": " FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding PanelName}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                            <Grid Margin="44,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource SD_PeakNits}" FontSize="12" VerticalAlignment="Center"
                                                           Margin="0,2,8,2"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <!-- Read-only: DDC/CI cannot report physical nits, the value
                                                     comes from the panel spec and is edited on the home page. -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PeakNits}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text=" " FontSize="12"/>
                                                    <TextBlock Text="{DynamicResource Brightness_NitsUnit}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>

            <!-- ── Link diagnostics: two compact rows, two label/value pairs
                 each (connector + bandwidth / power + USB). Fed by
                 LinkDiagnosticsService (QueryDisplayConfig). Rows stay visible
                 even when the connector couldn't be identified. -->
            <Grid Margin="44,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="{DynamicResource SD_Link_Title}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SD_Link_Connection}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,8,1"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LinkConnectionText}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,12,1" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource SD_Link_Bandwidth}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,8,1"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LinkBandwidthText}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,0,1" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SD_Link_Power}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,8,1"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LinkPowerText}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,12,1" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource SD_Link_Usb}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,8,1"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LinkUsbText}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,0,1" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="{Binding LinkWarningText}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,3,0,0"
                           Foreground="#FFB400"
                           Visibility="{Binding LinkWarningText, Converter={StaticResource StringToVisibilityConverter}}"/>
            </Grid>

            <Separator Margin="0,12,0,12"/>
            <TextBlock Text="{DynamicResource SD_ControlsTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                            <!-- ── DDC controls (hidden when the panel ignores DDC/CI) ── -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DdcAvailable}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="112"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource SD_Contrast}" FontSize="12" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                                Value="{Binding Contrast, Mode=TwoWay}" VerticalAlignment="Center"
                                                                IsEnabled="{Binding DdcAvailable}"/>
                                                        <controls:EditableValueBox Grid.Column="2"
                                                                                   Value="{Binding Contrast, Mode=TwoWay}"
                                                                                   Minimum="0" Maximum="100" Suffix="%"
                                                                                   FontSize="12" VerticalAlignment="Center"
                                                                                   IsEnabled="{Binding DdcAvailable}"
                                                                                   ToolTip="{DynamicResource SD_TypeHint}"/>
                                                    </Grid>
                                                    <Grid Grid.Column="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="112"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource SD_Volume}" FontSize="12" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                                Value="{Binding SpeakerVolume, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                        <controls:EditableValueBox Grid.Column="2"
                                                                                   Value="{Binding SpeakerVolume, Mode=TwoWay}"
                                                                                   Minimum="0" Maximum="100" Suffix="%"
                                                                                   FontSize="12" VerticalAlignment="Center"
                                                                                   ToolTip="{DynamicResource SD_TypeHint}"/>
                                                    </Grid>
                                                </Grid>

                                                <!-- Input source | Color mode -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="112"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource SD_Input}" FontSize="12" VerticalAlignment="Center"/>
                                                            <ComboBox Grid.Column="1" MinWidth="120" HorizontalAlignment="Stretch"
                                                                      ItemsSource="{Binding InputOptions}"
                                                                      SelectedItem="{Binding SelectedInput}"
                                                                      DisplayMemberPath="Label"
                                                                      Visibility="{Binding HasInputOptions, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Grid.Column="1" Text="{DynamicResource SD_NoInput}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       ToolTip="{DynamicResource SD_NoInputTip}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InputOptions.Count}" Value="0">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    <Grid Grid.Column="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="112"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource SD_ColorMode}" FontSize="12" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="1" MinWidth="120" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding PresetOptions}"
                                                                  SelectedItem="{Binding SelectedPreset}"
                                                                  DisplayMemberPath="Label"/>
                                                    </Grid>
                                                </Grid>

                                                <!-- Extra rows discovered on this panel: RGB gain,
                                                     sharpness, mute, scene mode ... two per row -->
                                                <ItemsControl ItemsSource="{Binding ExtraControls}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,20,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="112"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="40"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{Binding AccentBrush, TargetNullValue={StaticResource TextFillColorPrimaryBrush}}"/>
                                                                <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxValue}"
                                                                        Value="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"
                                                                        Visibility="{Binding SliderVisibility}"
                                                                        attached:SliderAccent.Accent="{Binding AccentColor}"/>
                                                                <ComboBox Grid.Column="1" MinWidth="100" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{Binding Options}"
                                                                          SelectedItem="{Binding SelectedOption}"
                                                                          DisplayMemberPath="Label"
                                                                          Visibility="{Binding ChoiceVisibility}"/>
                                                                <controls:EditableValueBox Grid.Column="2"
                                                                                           Value="{Binding Value, Mode=TwoWay}"
                                                                                           Minimum="0" Maximum="{Binding MaxValue}"
                                                                                           Suffix=""
                                                                                           FontSize="12" VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                           Visibility="{Binding SliderVisibility}"
                                                                                           ToolTip="{DynamicResource SD_TypeHint}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12"
                                                                           VerticalAlignment="Center" TextAlignment="Right"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Visibility="{Binding ChoiceVisibility}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- One-time probe of preset values takes a few seconds -->
                                                <TextBlock Text="{DynamicResource SD_Probing}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProbing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Software color: gamma-ramp based, works even on
                                                 panels that expose no DDC color control -->
                                            <Separator Margin="0,6,0,10"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource SD_SoftwareColorTitle}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource SD_SoftwareColorHint}" FontSize="11" Margin="8,1,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="112"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="52"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource SD_ColorTemp}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" VerticalAlignment="Center"
                                                            Minimum="4000" Maximum="9300"
                                                            SmallChange="100" LargeChange="500" TickFrequency="100" IsSnapToTickEnabled="True"
                                                            Value="{Binding ColorTemp, Mode=TwoWay}"/>
                                                    <controls:EditableValueBox Grid.Column="2"
                                                                               Value="{Binding ColorTemp, Mode=TwoWay}"
                                                                               Minimum="4000" Maximum="9300" Suffix="K"
                                                                               FontSize="12" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               ToolTip="{DynamicResource SD_TypeHint}"/>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="112"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="52"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource SD_EyeCareLevel}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                            Value="{Binding EyeCare, Mode=TwoWay}"/>
                                                    <controls:EditableValueBox Grid.Column="2"
                                                                               Value="{Binding EyeCare, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100" Suffix="%"
                                                                               FontSize="12" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               ToolTip="{DynamicResource SD_TypeHint}"/>
                                                </Grid>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{DynamicResource SD_ColorTempHint}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <wpfui:Button Content="{DynamicResource SD_ResetColor}" FontSize="12" Margin="12,0,0,0"
                                                              Padding="10,2" Appearance="Secondary"
                                                              Command="{Binding ResetColorCommand}"/>
                                            </StackPanel>

                                            <!-- OSD features this panel refuses to expose over DDC -->
                                            <TextBlock Text="{Binding HardwareOnlyText}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasHardwareOnly}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Not-DDC note -->
                                            <TextBlock Text="{DynamicResource SD_NoDdc}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DdcAvailable}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- No-preset hint -->
                                            <TextBlock Text="{DynamicResource SD_NoPreset}" FontSize="11" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PresetOptions.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- ── Orientation ── -->
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <TextBlock Text="{DynamicResource SD_Orientation}" FontSize="12" VerticalAlignment="Center"
                                                           Margin="0,0,16,0" Width="114"/>
                                                <wpfui:Button Content="{DynamicResource SD_Landscape}" Margin="0,0,8,0" MinWidth="88"
                                                              Command="{Binding ApplyLandscapeCommand}"
                                                              Appearance="Secondary"/>
                                                <wpfui:Button Content="{DynamicResource SD_Portrait}" MinWidth="88"
                                                              Command="{Binding ApplyPortraitCommand}"
                                                              Appearance="Secondary"/>
                                            </StackPanel>

                                            <!-- ── Status line ── -->
                                            <TextBlock FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="writefail">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="{DynamicResource SD_WriteFail}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="inputverify">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="{DynamicResource SD_InputVerify}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="rotatefail">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="{DynamicResource SD_RotateFail}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="notsupported">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="{DynamicResource SD_NotSupported}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </wpfui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══ PINNED APPS PAGE ═══ -->
            <Border x:Name="PinnedPage" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <Grid Margin="24,20,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Pinned_Title}" FontSize="20" FontWeight="Medium"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,4,0,0"
                                   Text="{DynamicResource Pinned_Desc}"/>
                    </StackPanel>

                    <Border Grid.Row="1" MinHeight="80"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AppOverrides}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="20,12"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Icon slot: app icon if we've captured it, else a pin glyph.
                                                         Icon is captured at pin time from the live session and
                                                         back-filled for disk-loaded pins when the app next plays.
                                                         Both visuals live in the same slot so the row layout is
                                                         stable either way. -->
                                                    <Grid Grid.Column="0" Width="20" Height="20"
                                                          Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="20" Height="20"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding Icon, Converter={StaticResource NotNullToVis}}"/>
                                                        <wpfui:SymbolIcon Symbol="Pin24" FontSize="18"
                                                                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                          Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}"
                                                               FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding AudioDeviceName}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="13" VerticalAlignment="Center"/>
                                                    <wpfui:Button Grid.Column="3" Icon="Delete24"
                                                                  Appearance="Transparent" Width="32" Height="32"
                                                                  ToolTip="{DynamicResource Pinned_RemoveTip}"
                                                                  Tag="{Binding}"
                                                                  Click="RemovePinFromList_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding AppOverrides.Count, Converter={StaticResource ZeroToVis}}"
                                        IsHitTestVisible="False">
                                <wpfui:SymbolIcon Symbol="Pin24" FontSize="32" Opacity="0.3"
                                                  HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Pinned_Empty_Title}" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Pinned_Empty_Desc}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ SETTINGS PAGE ═══ -->
            <Border x:Name="SettingsPage" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Title}" FontSize="20" FontWeight="Medium" Margin="0,0,0,16"/>

                        <!-- Theme -->
                        <wpfui:CardControl Margin="0,0,0,8">
                            <wpfui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="DarkTheme24" FontSize="20"
                                                      Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings_Theme_Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Settings_Theme_Desc}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </wpfui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                      SelectedIndex="{Binding SelectedThemeIndex}"
                                      MinWidth="120"/>
                        </wpfui:CardControl>

                        <!-- Language — entries stay in their own language on purpose
                             so a user who switched to the wrong one can switch back. -->
                        <wpfui:CardControl Margin="0,0,0,8">
                            <wpfui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="LocalLanguage24" FontSize="20"
                                                      Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings_Language_Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Settings_Language_Desc}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </wpfui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding LanguageOptions}"
                                      SelectedIndex="{Binding SelectedLanguageIndex}"
                                      MinWidth="120"/>
                        </wpfui:CardControl>

                        <!-- Run at startup -->
                        <wpfui:CardControl Margin="0,0,0,8">
                            <wpfui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="Power24" FontSize="20"
                                                      Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings_AutoStart_Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Settings_AutoStart_Desc}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </wpfui:CardControl.Header>
                            <wpfui:ToggleSwitch IsChecked="{Binding AutoStartWithWindows}"/>
                        </wpfui:CardControl>

                        <!-- Minimize on close -->
                        <wpfui:CardControl Margin="0,0,0,8">
                            <wpfui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="ArrowMinimize24" FontSize="20"
                                                      Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings_MinimizeOnClose_Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Settings_MinimizeOnClose_Desc}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </wpfui:CardControl.Header>
                            <wpfui:ToggleSwitch IsChecked="{Binding MinimizeOnClose}"/>
                        </wpfui:CardControl>

                        <!-- Start minimized -->
                        <wpfui:CardControl Margin="0,0,0,8">
                            <wpfui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="EyeOff24" FontSize="20"
                                                      Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings_StartMinimized_Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Settings_StartMinimized_Desc}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </wpfui:CardControl.Header>
                            <wpfui:ToggleSwitch IsChecked="{Binding StartMinimized}"/>
                        </wpfui:CardControl>

                        <!-- Keep audio device when window is hidden -->
                        <wpfui:CardControl Margin="0,0,0,8">
                            <wpfui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="Speaker224" FontSize="20"
                                                      Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings_HoldRouting_Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Settings_HoldRouting_Desc}" FontSize="11"
                                                   TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </wpfui:CardControl.Header>
                            <wpfui:ToggleSwitch IsChecked="{Binding HoldWhenWindowHidden}"/>
                        </wpfui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══ ABOUT PAGE ═══ -->
            <Border x:Name="AboutPage" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About_Title}" FontSize="20" FontWeight="Medium" Margin="0,0,0,16"/>
                        <wpfui:Card Padding="24">
                            <StackPanel>
                                <!-- ── Header: icon + identity block ────────────────
                                     Identity block stacks three lines next to the
                                     48px icon: product name, version, and copyright.
                                     Version and copyright both come from assembly
                                     metadata (MSBuild fills them from the csproj's
                                     <Version> / <Copyright> properties) so the UI
                                     always matches what shipped.
                                -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <!--
                                        App icon from Assets/app-icon.png — a 256x256 PNG rasterised
                                        from design/app-icon.svg. PNG (not the multi-image app.ico)
                                        because BitmapImage picks the first frame of an ICO, which
                                        for our 16/20/24/32/... layout is the tiny 16x16 glyph.
                                    -->
                                    <Image Source="/Assets/app-icon.png" Width="48" Height="48"
                                           VerticalAlignment="Center" Margin="0,0,16,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SimpleScreen" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AppVersionDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CopyrightDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

                                <!-- ── Links ────────────────────────────────────────
                                     Two static GitHub URLs pointing at our own repo
                                     (xunhualu/SimpleScreen), not the upstream
                                     ScreenSound fork. /releases/latest redirects
                                     to the current tag so we don't have to bake a
                                     version into the URL here.

                                     Padding is tightened from the default wpfui:Button
                                     (11,5,11,6) down to 8,2 so the stacked hyperlinks
                                     read as a compact list rather than two spaced-out
                                     buttons. No margin between them — the reduced
                                     padding alone gives enough breathing room.
                                -->
                                <TextBlock Text="{DynamicResource About_Links}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <wpfui:Hyperlink Content="{DynamicResource About_ProjectSite}"
                                                 Icon="Link24"
                                                 NavigateUri="https://github.com/xunhualu/SimpleScreen"
                                                 HorizontalAlignment="Left" Padding="8,2"/>
                                <wpfui:Hyperlink Content="{DynamicResource About_LatestRelease}"
                                                 Icon="Link24"
                                                 NavigateUri="https://github.com/xunhualu/SimpleScreen/releases/latest"
                                                 HorizontalAlignment="Left" Padding="8,2"/>

                                <!-- ── Update check ─────────────────────────────────
                                     User-initiated (no background polling) so we
                                     don't hit GitHub's rate limit without consent.
                                     The button is disabled while a probe is in flight
                                     and the result is rendered next to it in one
                                     status line. If a newer version is available,
                                     the Download hyperlink appears with the release
                                     URL.
                                -->
                                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,20,0,16"/>
                                <TextBlock Text="{DynamicResource About_Updates}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <!--
                                    Grid (rather than a horizontal StackPanel) so the status
                                    TextBlock can actually wrap to the content card's width.
                                    StackPanel gives children infinite horizontal space, which
                                    silently defeats TextWrapping — a long "Update available:
                                    1.2.3" string would clip outside the card. Button keeps
                                    its intrinsic width (Auto column); the wrap column (*)
                                    takes the remainder.
                                -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <wpfui:Button Grid.Column="0"
                                                  Content="{DynamicResource About_CheckForUpdates}"
                                                  Icon="ArrowSync24"
                                                  Command="{Binding CheckForUpdatesCommand}"
                                                  IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBooleanConverter}}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding UpdateStatus}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <!-- Hyperlink only shown when an update is available (LatestReleaseUrl is
                                     non-empty). wpfui:Hyperlink derives from wpfui:Button and, on click,
                                     opens NavigateUri via ShellExecute — no Command wiring needed. -->
                                <wpfui:Hyperlink Content="{DynamicResource About_OpenReleasePage}"
                                                 Icon="Open24"
                                                 NavigateUri="{Binding LatestReleaseUrl}"
                                                 HorizontalAlignment="Left"
                                                 Visibility="{Binding LatestReleaseUrl, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </wpfui:Card>

                        <!-- ── About-this-build card (merged from the retired Donate tab):
                             accent icon + identity block header, same pattern as the
                             support card below. ── -->
                        <wpfui:Card Padding="24" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <wpfui:SymbolIcon Symbol="Person24" FontSize="28"
                                                      Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                      VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{DynamicResource Donate_AboutMeTitle}" FontSize="16" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           LineHeight="21" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{DynamicResource Donate_AboutMeDesc}"/>
                            </StackPanel>
                        </wpfui:Card>

                        <!-- ── Support card (merged from the retired Donate tab). Placed below
                             the maintainer card so this customized build introduces itself first. ── -->
                        <wpfui:Card Padding="24" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <wpfui:SymbolIcon Symbol="Heart24" FontSize="28"
                                                      Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                      VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="{DynamicResource Donate_SupportTitle}" FontSize="16" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{DynamicResource Donate_Desc}"/>
                            </StackPanel>
                        </wpfui:Card>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══ HOTKEY PAGE ═══ -->
            <!-- Focusable so PreviewKeyDown fires even before any inner control has
                 focus; the recording flow relies on the tunneling handler below. -->
            <Border x:Name="HotkeyPage" Visibility="Collapsed" Opacity="0"
                    Focusable="True" PreviewKeyDown="HotkeyPage_PreviewKeyDown"
                    PreviewKeyUp="HotkeyPage_PreviewKeyUp">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource HK_Title}" FontSize="20" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource HK_TypingGuard}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,16"/>

                        <!-- ══ One row per feature. Each hotkey is split into TWO
                             independently clickable cells: modifier cell + main-key
                             cell. Click either cell, press a key, only that cell
                             changes — no separate "record" button is needed. ══ -->

                        <!-- ── Row 1 · window jump ── -->
                        <wpfui:Card Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Feature name, BOTH key cells and the enable
                                     switch share a single horizontal row. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <wpfui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="20"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                MinWidth="150" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource HK_Move_Title}" FontSize="14"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="MoveDetailsButton" Click="MoveDetailsButton_Click"
                                                Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" Padding="0,2"
                                                Cursor="Hand" ToolTip="{DynamicResource HK_DetailsTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource HK_Details}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock x:Name="MoveDetailsChevron"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                           Text="&#xE70D;" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Border Grid.Column="3" x:Name="JumpModifierBox"
                                            CornerRadius="5" Height="34" Width="112"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" Cursor="Hand" VerticalAlignment="Center"
                                            ToolTip="{DynamicResource HK_ModifierTip}"
                                            MouseLeftButtonDown="JumpModifierBox_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding JumpModifierDisplay}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Grid.Column="4" Text="+" FontSize="14" Margin="10,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                    <Border Grid.Column="5" x:Name="JumpKeyBox"
                                            CornerRadius="5" Height="34" Width="112"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" Cursor="Hand" VerticalAlignment="Center"
                                            ToolTip="{DynamicResource HK_KeyBoxTip}"
                                            MouseLeftButtonDown="JumpKeyBox_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding JumpKeyDisplay}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                    </Border>

                                </Grid>

                                <!-- Switches get their own row: two of them side by side
                                     would overflow the card on a narrow window. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource HK_Switch_Hotkey}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <wpfui:ToggleSwitch IsChecked="{Binding IsJumpHotkeyEnabled}"
                                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Only transient messages and the expanded
                                     description ever occupy a second line. -->
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="HotkeyRecordStatus" Text="{DynamicResource HK_Recording}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               Visibility="Collapsed"/>
                                    <TextBlock Text="{Binding HotkeyStatus}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="#FFB400" Margin="0,2,0,0"
                                               Visibility="{Binding HotkeyStatus, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <StackPanel x:Name="MoveDetailsPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource HK_Move_Desc}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{DynamicResource HK_Key_Desc}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </wpfui:Card>

                        <!-- ── Row 2 · layout tiling ── -->
                        <wpfui:Card Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Feature name, BOTH key cells and the enable
                                     switch share a single horizontal row. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <wpfui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="20"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                MinWidth="150" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource HK_Auto_Title}" FontSize="14"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="ArrangeDetailsButton" Click="ArrangeDetailsButton_Click"
                                                Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" Padding="0,2"
                                                Cursor="Hand" ToolTip="{DynamicResource HK_DetailsTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource HK_Details}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock x:Name="ArrangeDetailsChevron"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                           Text="&#xE70D;" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Border Grid.Column="3" x:Name="ArrangeModifierBox"
                                            CornerRadius="5" Height="34" Width="112"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" Cursor="Hand" VerticalAlignment="Center"
                                            ToolTip="{DynamicResource HK_ModifierTip}"
                                            MouseLeftButtonDown="ArrangeModifierBox_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding ArrangeModifierDisplay}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Grid.Column="4" Text="+" FontSize="14" Margin="10,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                    <Border Grid.Column="5" x:Name="ArrangeKeyBox"
                                            CornerRadius="5" Height="34" Width="112"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" Cursor="Hand" VerticalAlignment="Center"
                                            ToolTip="{DynamicResource HK_KeyBoxTip}"
                                            MouseLeftButtonDown="ArrangeKeyBox_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding ArrangeKeyDisplay}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                    </Border>

                                </Grid>

                                <!-- TWO independent switches: one for the U hotkey,
                                     one for the no-key automatic tiling watcher. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource HK_Switch_Hotkey}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               ToolTip="{DynamicResource HK_Switch_HotkeyTip}"/>
                                    <wpfui:ToggleSwitch IsChecked="{Binding IsArrangeHotkeyEnabled}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{DynamicResource HK_Switch_HotkeyTip}"/>
                                    <TextBlock Text="{DynamicResource HK_Switch_Auto}" FontSize="11"
                                               VerticalAlignment="Center" Margin="14,0,6,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               ToolTip="{DynamicResource HK_Switch_AutoTip}"/>
                                    <wpfui:ToggleSwitch IsChecked="{Binding IsAutoArrangeEnabled}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{DynamicResource HK_Switch_AutoTip}"/>
                                </StackPanel>

                                <!-- Only transient messages and the expanded
                                     description ever occupy a second line. -->
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="ArrangeRecordStatus" Text="{DynamicResource HK_Recording}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               Visibility="Collapsed"/>
                                    <TextBlock Text="{Binding ArrangeHotkeyStatus}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="#FFB400" Margin="0,2,0,0"
                                               Visibility="{Binding ArrangeHotkeyStatus, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <StackPanel x:Name="ArrangeDetailsPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource HK_Auto_Desc}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{DynamicResource HK_ArrangeKey_Desc}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </wpfui:Card>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</wpfui:UiWindow>
